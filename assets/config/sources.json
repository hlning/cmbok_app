    {
      "type": "api",
      "engine": "zaimanhua",
      "config": {
        "id": "zaimanhua",
        "base": "https://manhua.zaimanhua.com/",
        "ua": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        "envelope": {
          "codeField": "errno",
          "dataField": "data",
          "msgField": "errmsg",
          "successCode": 0
        },
        "search": {
          "path": "app/v1/search/index",
          "queryKey": "keyword",
          "pageKey": "page",
          "sizeKey": "size",
          "size": 20,
          "listField": "list",
          "idField": "id",
          "fields": {
            "title": "title",
            "cover": "cover",
            "authors": "authors",
            "status": "status",
            "hot": "hot_hits"
          }
        },
        "category": {
          "filterTypePath": "api/v1/comic1/filter_type",
          "filterPath": "api/v1/comic1/filter",
          "titles": {
            "sortType": "排序",
            "audience": "受众",
            "cate": "类别",
            "firstLetter": "首字母",
            "status": "状态",
            "theme": "题材"
          },
          "listField": "comicList",
          "totalField": "totalNum",
          "idField": "id",
          "optionNameField": "name",
          "fields": {
            "name": "name",
            "cover": "cover",
            "authors": "authors",
            "status": "status"
          }
        },
        "detail": {
          "path": "api/v1/comic2/comic/detail",
          "idKey": "id",
          "infoField": "comicInfo",
          "fields": {
            "title": "title",
            "cover": "cover",
            "description": "description",
            "hotStr": "hotNumStr"
          },
          "tagFields": {
            "authors": "authorsTagList",
            "status": "statusTagList",
            "tagName": "tagName"
          },
          "canReadField": "canRead",
          "chapterListField": "chapterList",
          "groupTitleField": "title",
          "groupDataField": "data",
          "chapterFields": {
            "id": "chapter_id",
            "title": "chapter_title",
            "order": "chapter_order",
            "updateTime": "updatetime"
          }
        },
        "chapterImage": {
          "path": "api/v1/comic2/chapter/detail",
          "comicIdKey": "comic_id",
          "chapterIdKey": "chapter_id",
          "infoField": "chapterInfo",
          "pageUrlField": "page_url"
        },
        "hotUnits": {
          "万": 10000,
          "千": 1000
        },
        "delistedStatus": "已下架",
        "delistedTextPrefix": "⚠️ 该漫画章节已被源站下架删除，暂无法阅读"
      }
    },
